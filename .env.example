PORT=5000
NODE_ENV=development

# Required in production (server refuses to start without them)
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
MONGODB_URI=mongodb://127.0.0.1:27017/dating_chat_app

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed browser origins, comma-separated (first one is used in reset-password links)
CLIENT_URL=http://localhost:5173

# Development conveniences (all forced off when NODE_ENV=production)
ALLOW_IN_MEMORY_DB=true
EXPOSE_RESET_TOKEN=true
# Demo users alice/bob/charlie (password: Password123!). Defaults to true outside production.
SEED_DEMO_DATA=true

# SMTP for password reset emails (required for password reset in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ConnectPulse <no-reply@example.com>

# How long an unanswered call rings before it is marked missed
CALL_RING_TIMEOUT_MS=45000

# Network interface the API listens on (0.0.0.0 = reachable from phones on your Wi-Fi)
HOST=0.0.0.0
# If MongoDB is not running locally, start a bundled MongoDB storing data in this folder
PERSIST_LOCAL_DB=true
LOCAL_DB_DIR=.local-db
